# ============================================================================
# CẤU HÌNH BACKEND AERODRY IoT – NHÓM 21 – LỚP 24C11 (W18, W19-Phong, W21)
# Sao chép file này thành .env và điền thông tin tài khoản thực tế
# ============================================================================

GROUP_ID=G21_24C11
DEVICE_ID=esp32_01

# 1. Cấu hình MQTT Broker
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 2. Cấu hình Firebase Cloud Firestore (W18, W19)
# Đường dẫn tới file JSON Service Account tải từ Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=aerodry-iot-g21
# Chu kỳ lưu mẫu cảm biến định kỳ lên Firestore (Mục 3.7: dự kiến 60 giây)
SENSOR_SAMPLE_SAVE_INTERVAL_MS=60000

# 3. Cấu hình PushSafer API (W21 - Thông báo đẩy điện thoại)
PUSHSAFER_PRIVATE_KEY=your_pushsafer_private_key_here
PUSHSAFER_DEVICE_ID=a
PUSHSAFER_ICON=11
PUSHSAFER_SOUND=10
PUSHSAFER_VIBRATION=2

# 4. Cấu hình Email SMTP (W21 - Email cảnh báo mưa & độ ẩm cao kéo dài)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
ALERT_RECIPIENT_EMAIL=user_recipient@gmail.com

# 5. Chống gửi trùng và thử lại khi lỗi (W21 - Mục 3.8)
ALERT_COOLDOWN_MS=900000
NOTIFY_MAX_RETRIES=3
NOTIFY_RETRY_DELAY_MS=2000
