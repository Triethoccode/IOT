# ============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN AERODRY IOT (SmartBreeze Pro)
# Sao chép file này thành .env và điền các giá trị thực tế.
# File .env đã được cấu hình trong .gitignore, tuyệt đối KHÔNG commit .env lên Git!
# ============================================================================

# 1. Cấu hình Cổng & Broker MQTT
PORT=1880
AERODRY_MQTT_HOST=broker.hivemq.com
AERODRY_MQTT_PORT=1883

# 2. Cấu hình PushSafer API (W21 - Thông báo đẩy tới điện thoại)
PUSHSAFER_PRIVATE_KEY=your_pushsafer_private_key_here

# 3. Cấu hình Email SMTP (W21 - Cảnh báo mưa & độ ẩm cao kéo dài)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
ALERT_RECIPIENT_EMAIL=your_recipient@gmail.com

# 4. Tài khoản quản trị điều khiển cục bộ (Tùy chọn ghi đè control.local.json)
# AERODRY_CONTROL_EMAIL=admin@aerodry.vn
# AERODRY_CONTROL_PASSWORD_HASH=...

# 5. Cấu hình chu kỳ và cooldown
ALERT_COOLDOWN_MS=900000
SENSOR_SAMPLE_SAVE_INTERVAL_MS=60000
